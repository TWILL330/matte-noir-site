# ── Backend ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@db:5432/kantata_reddit
REDIS_URL=redis://redis:6379/0
APP_ENV=development

# Space-separated list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000"]

# ── Frontend ───────────────────────────────────────────────────────────────
# Must be reachable from the BROWSER (not the Next.js server container)
NEXT_PUBLIC_API_URL=http://localhost:8000
